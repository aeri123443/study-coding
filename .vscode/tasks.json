{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ 활성 파일 빌드",
            "command": "/usr/bin/g++",
            "args": [
                "-std=c++17",
                "-fdiagnostics-color=always",
                "-O2",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "디버거에서 생성된 작업입니다."
        },
        {
            "type": "shell",
            "label": "build-and-run",
            "command": "/usr/bin/g++",
            "args": [
                "-std=c++17",
                "-O2",
                {
                    "value": "${file}",
                    "quoting": "strong"
                },
                "-o",
                {
                    "value": "${fileDirname}/out",
                    "quoting": "strong"
                },
                "&&",
                {
                    "value": "${fileDirname}/out",
                    "quoting": "strong"
                }
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "clear": true
            }
        }
    ]
}